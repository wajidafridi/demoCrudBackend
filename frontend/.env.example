# API base URL, including the /api prefix.
# This matches the https launch profile at https://localhost:7193.
# If you start the API with --launch-profile http, use http://localhost:5118/api instead.
VITE_API_BASE_URL=https://localhost:7193/api

# Optional. Applied only while Vite is in development mode (npm run dev).
# Do not commit real credentials. Leave these unset in shared copies.
# VITE_DEV_LOGIN_USERNAME=
# VITE_DEV_LOGIN_PASSWORD=
