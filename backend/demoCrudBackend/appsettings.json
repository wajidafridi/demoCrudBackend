{
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;database=demoCrudDb;user=YOUR_MYSQL_USER;password=YOUR_MYSQL_PASSWORD;"
  },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "ChangePasswordPermitLimit": 5,
    "ChangePasswordWindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "DemoCrudBackend",
    "Audience": "DemoCrudFrontend",
    "AccessTokenMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
